<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key><string>English</string>
    <key>CFBundleDisplayName</key><string>EvoBuddy</string>
    <!-- The launcher script; the real Mach-O is evobuddy-bin beside it. -->
    <key>CFBundleExecutable</key><string>evobuddy</string>
    <key>CFBundleIconFile</key><string>evobuddy</string>
    <key>CFBundleIdentifier</key><string>io.github.c2j.evobuddy</string>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <key>CFBundleName</key><string>EvoBuddy</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>@VERSION@</string>
    <key>CFBundleVersion</key><string>@VERSION@</string>
    <!-- The oldest macOS the bundled Homebrew libraries themselves ask for. -->
    <key>LSMinimumSystemVersion</key><string>@MINOS@</string>
    <key>NSHighResolutionCapable</key><true/>
    <key>NSPrincipalClass</key><string>NSApplication</string>
</dict>
</plist>
