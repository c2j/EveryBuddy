# Build the app on the oldest glibc this project supports.
#
# Debian 10 == glibc 2.28, the stated floor. This is not just convenience: the
# symbol versions a binary asks for are those of the environment it was built
# in, so a binary built on anything newer will refuse to start on 2.28.
FROM debian:10

# Buster is EOL and has moved to the archive, whose Release files have expired
# valid-until dates.
#
# librsvg2-bin is here for rsvg-convert (rendering the icon) and, with it, the
# SVG gdk-pixbuf loader, which the bundle copies along with the other loaders.
RUN printf 'deb http://archive.debian.org/debian buster main\ndeb http://archive.debian.org/debian-security buster/updates main\n' > /etc/apt/sources.list \
 && printf 'Acquire::Check-Valid-Until "false";\n' > /etc/apt/apt.conf.d/99-archive \
 && apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y \
      build-essential pkg-config libgtk-3-dev libgtk-3-bin libglib2.0-bin \
      fonts-dejavu-core fonts-wqy-microhei librsvg2-bin ca-certificates curl file \
 && rm -rf /var/lib/apt/lists/*

# Rust's own glibc baseline (2.17) is older than this image's 2.28, so a stock
# rustup toolchain keeps the result runnable here and on anything newer.
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
      | sh -s -- -y --profile minimal --default-toolchain stable --no-modify-path

COPY Cargo.toml Cargo.lock /src/
COPY src/ /src/src/
COPY ui/ /src/ui/
COPY docs/ui-spec/gtk/ /src/docs/ui-spec/gtk/
COPY packaging/linux/ /src/packaging/linux/

WORKDIR /src
RUN cargo build --release --bin evobuddy
